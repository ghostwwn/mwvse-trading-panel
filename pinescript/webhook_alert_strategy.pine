//@version=5
// ──────────────────────────────────────────────────────────────────────────────
// MWVSE TRADING PANEL — Webhook Alert Strategy Template
// Engineered by @ghostwwn (https://github.com/ghostwwn)
// ──────────────────────────────────────────────────────────────────────────────
strategy("MWVSE Webhook Strategy by @ghostwwn", overlay=true, margin_long=100, margin_short=100)

// Configurable Settings
secretToken = input.string("your_super_secret_webhook_key_here", title="Webhook Secret")
tradeShares = input.int(25, title="Shares per Trade")
fastLength  = input.int(9, title="Fast EMA")
slowLength  = input.int(21, title="Slow EMA")

// Indicators
fastEMA = ta.ema(close, fastLength)
slowEMA = ta.ema(close, slowLength)

longCondition = ta.crossover(fastEMA, slowEMA)
shortCondition = ta.crossunder(fastEMA, slowEMA)

// Webhook Alert JSON Payloads
buyAlertJson = '{"secret": "' + secretToken + '", "ticker": "' + syminfo.ticker + '", "action": "buy", "shares": ' + str.tostring(tradeShares) + '}'
sellAlertJson = '{"secret": "' + secretToken + '", "ticker": "' + syminfo.ticker + '", "action": "sell", "shares": ' + str.tostring(tradeShares) + '}'

if (longCondition)
    strategy.entry("Long", strategy.long)
    alert(buyAlertJson, alert.freq_once_per_bar_close)

if (shortCondition)
    strategy.close("Long")
    alert(sellAlertJson, alert.freq_once_per_bar_close)

plot(fastEMA, color=color.aqua, title="Fast EMA")
plot(slowEMA, color=color.orange, title="Slow EMA")
