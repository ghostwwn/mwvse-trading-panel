# ──────────────────────────────────────────────────────────────────────────────
# MWVSE TRADING PANEL — ENVIRONMENT CONFIGURATION
# Engineered by @ghostwwn (https://github.com/ghostwwn)
# ──────────────────────────────────────────────────────────────────────────────

# 1. GAME SETTINGS
# Either paste your full MarketWatch game URL, e.g.:
# MW_GAME_URL=https://www.marketwatch.com/games/bayonne-high-school-fall-2026-stock-market-game
# OR just the game slug:
MW_GAME_SLUG=bayonne-high-school-fall-2026-stock-market-game

# 2. SERVER & WEBHOOK CONFIGURATION
HOST=127.0.0.1
PORT=8000
# Generate a secret token for your TradingView webhooks:
WEBHOOK_SECRET=your_super_secret_webhook_key_here

# 3. AUTONOMOUS TRADING & SUPERVISOR SETTINGS
# Strategy Preset: "HUNTER" (Momentum Breakouts), "SNIPER" (High-conviction scalper), "BALANCED"
AUTOPILOT_STRATEGY=HUNTER
AUTOPILOT_ACTIVE=true
AUTOPILOT_SCAN_INTERVAL=30
AUTOPILOT_HARVEST_INTERVAL=15
MAX_CONCURRENT_POSITIONS=10
DEFAULT_SHARES=25
ALLOCATION_PER_TRADE_DOLLARS=15000.0
ALLOW_SHORTING=true
MIN_CONVICTION_THRESHOLD=75
TICKER_COOLDOWN_SECONDS=600
TAKE_PROFIT_PCT=2.5
STOP_LOSS_PCT=-2.0

# 4. MARKETWATCH LOGIN (OPTIONAL: run `python main.py setup` for 1-click interactive login)
MW_EMAIL=
MW_PASSWORD=
MW_HEADLESS=true
